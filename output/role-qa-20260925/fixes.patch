+"use client"
+
+import type { ReactNode } from "react"
+import { PermissionDeniedState } from "@/components/error-state"
+import { PermissionError, PermissionLoading } from "@/components/permissions/permission-controls"
+import { useAuth } from "@/lib/auth-context"
+import { useEffectivePermissions } from "@/lib/hooks/use-permissions"
+
+export function AppointmentAccess({ children }: { children: ReactNode }) {
+    const { user } = useAuth()
+    const effective = useEffectivePermissions(user?.user_id ?? null)
+    if (effective.error) return <PermissionError error={effective.error} retry={() => void effective.refetch()} />
+    if (!effective.data) return <PermissionLoading />
+    if (!effective.data.permissions.includes("manage_appointments")) {
+        return <PermissionDeniedState description="Your account does not have permission to manage appointments." />
+    }
+    return children
+}
