+import { beforeEach, expect, it, vi } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import AppointmentsPage from '@/app/(app)/appointments/page'
+import { AppointmentSettings } from '@/components/appointments/AppointmentSettings'
+import { TasksCalendarView } from '@/components/tasks/TasksCalendarView'
+
+const state = vi.hoisted(() => ({ permissions: [] as string[], loading: false, booking: vi.fn(), calendar: vi.fn() }))
+vi.mock('@/lib/auth-context', () => ({ useAuth: () => ({ user: { user_id: 'operations' } }) }))
+vi.mock('@/lib/hooks/use-permissions', () => ({ useEffectivePermissions: () => ({ data: state.loading ? undefined : { permissions: state.permissions }, isLoading: state.loading }) }))
+vi.mock('@/components/appointments/AppointmentsList', () => ({ AppointmentsList: () => <div>Appointment list</div> }))
+vi.mock('@/lib/hooks/use-appointments', () => ({
+    useBookingLink: () => { state.booking(); return {} },
+    useAvailabilityRules: () => ({ isLoading: true }),
+    useSetAvailabilityRules: () => ({ mutateAsync: vi.fn() }),
+}))
+vi.mock('@/lib/hooks/use-user-integrations', () => ({ useUserIntegrations: () => ({ data: [] }) }))
+vi.mock('@/components/appointments/UnifiedCalendar', () => ({ UnifiedCalendar: (props: { includeAppointments?: boolean }) => { state.calendar({ ...props, includeAppointments: props.includeAppointments ?? true }); return <div>Task calendar</div> } }))
+
+beforeEach(() => { state.permissions = []; state.loading = false; vi.clearAllMocks() })
+
+it('denies appointment navigation without loading a booking link', () => {
+    render(<AppointmentsPage />)
+    expect(screen.getByText('Permission required')).toBeInTheDocument()
+    expect(state.booking).not.toHaveBeenCalled()
+    expect(screen.queryByText('Appointment list')).not.toBeInTheDocument()
+})
+
+it('waits for permission before loading appointments', () => {
+    state.loading = true
+    render(<AppointmentsPage />)
+    expect(state.booking).not.toHaveBeenCalled()
+})
+
+it('allows appointment management for an authorized role', () => {
+    state.permissions = ['manage_appointments']
+    render(<AppointmentsPage />)
+    expect(screen.getByText('Appointment list')).toBeInTheDocument()
+})
+
+it('denies availability settings before mounting its data requests', () => {
+    render(<AppointmentSettings />)
+    expect(screen.getByText('Permission required')).toBeInTheDocument()
+})
+
+it('keeps the Operations task calendar without requesting appointments', () => {
+    render(<TasksCalendarView filter="my_tasks" onTaskClick={() => {}} />)
+    expect(state.calendar).toHaveBeenCalledWith(expect.objectContaining({ includeAppointments: false }))
+})
+
+it('includes appointments in an authorized staff task calendar', () => {
+    state.permissions = ['manage_appointments']
+    render(<TasksCalendarView filter="my_tasks" onTaskClick={() => {}} />)
+    expect(state.calendar).toHaveBeenCalledWith(expect.objectContaining({ includeAppointments: true }))
+})
