{
  "name": "my-v0-project",
  "version": "0.3.0",
  "packageManager": "pnpm@12.9.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:stages": "if [ -x ../api/.venv/bin/python ]; then cd ../api && .venv/bin/python ../../scripts/gen_stage_map.py; else echo 'Skipping stage generation (apps/api/.venv missing)'; fi",
    "gen:surrogate-contracts": "if [ -x ../api/.venv/bin/python ]; then cd ../api && .venv/bin/python ../../scripts/gen_surrogate_contracts.py; else echo 'Skipping surrogate contract generation (apps/api/.venv missing)'; fi",
    "prebuild": "pnpm run gen:stages && pnpm run gen:surrogate-contracts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --incremental false -p tests/tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:all": "pnpm run test",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "check": "pnpm run typecheck && pnpm run typecheck:tests && pnpm run lint && pnpm run test",
    "analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@react-email/editor": "1.7.11",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/d3-scale": "^4.0.9",
    "@types/react-simple-maps": "^3.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.16",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.22.0",
    "markdown-it": "14.3.1",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.9.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.13.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "e2e": "0.18.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "8.1.0",
    "vitest": "^5.0.3"
  }
}
